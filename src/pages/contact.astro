---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import TerminalBox from '../components/TerminalBox.astro';
import content from '../../content/site-content.json';
---

<BaseLayout title="Contact | Alex Brackx">
  <Section id="contact" title="contact.sh" subtitle={content.contact.description}>
    <div class="contact-container">
      <TerminalBox title="Get in touch">
        <div class="contact-content">
          <p class="terminal-prompt">Ready to connect?</p>
          <p>Drop me a line and let's chat about databases, development or the best ski resorts.</p>
          <div class="contact-info">
            <a href="mailto:alex@brahts.dev" class="contact-link">
              <span class="terminal-prompt">email</span>
            </a>
            <a href="https://github.com/abrackx" target="_blank" rel="noopener noreferrer" class="contact-link">
              <span class="terminal-prompt">github</span>
            </a>
            <a href="https://www.linkedin.com/in/alex-brackx/" target="_blank" rel="noopener noreferrer" class="contact-link">
              <span class="terminal-prompt">linkedin</span>
            </a>
          </div>
        </div>
      </TerminalBox>

      <div class="page-nav">
        <a href="/hobbies" class="btn">← hobbies</a>
        <a href="/" class="btn">back to home</a>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .contact-container {
    max-width: 600px;
    margin: 0 auto;
  }

  .contact-content {
    text-align: center;
  }

  .contact-info {
    display: flex;
    justify-content: center;
    gap: var(--spacing-md);
    margin-top: var(--spacing-lg);
    flex-wrap: wrap;
  }

  .contact-link {
    display: inline-block;
    padding: var(--spacing-sm) var(--spacing-md);
    border: var(--border-retro);
    transition: var(--transition-smooth);
  }

  .contact-link:hover {
    background: var(--color-accent);
    color: var(--color-bg-primary);
    box-shadow: var(--glow-md);
    transform: translateY(-2px);
  }

  .page-nav {
    display: flex;
    justify-content: space-between;
    gap: var(--spacing-md);
    margin-top: var(--spacing-lg);
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .contact-info {
      flex-direction: column;
      align-items: center;
    }

    .page-nav {
      flex-direction: column;
    }
  }
</style>
